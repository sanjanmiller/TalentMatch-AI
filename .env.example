
# Primary Gemini provider
# Model IDs must match names returned by client.models.list().
# Valid text models include: gemini-3.8-flash, gemini-3.6-flash,
# gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite.
# Newer flagship models can return HTTP 503 (UNAVAILABLE, "high demand")
# when capacity is exhausted; the fallback chain then uses the next provider.
GEMINI_API_KEY=
GEMINI_MODEL=

# Secondary Gemini provider
GEMINI_SECONDARY_API_KEY=
GEMINI_SECONDARY_MODEL=

# Groq fallback provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gmail SMTP configuration for shortlisting emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_SENDER_NAME=HR Team
